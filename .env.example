# Base URL of the Django REST API (ends with /api, no trailing slash).
# The dev/preview server proxies "/api" requests to this origin, which avoids CORS.
VITE_API_URL=http://127.0.0.1:8000/api

# Optional: set to true to call VITE_API_URL directly from the browser instead
# of through the proxy. Only works if the backend sends CORS headers.
# VITE_API_DIRECT=false
